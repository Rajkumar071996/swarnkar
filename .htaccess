<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On

    # Hide the /public/ prefix so https://gold.smallfinance.net/ works.
    RewriteCond %{THE_REQUEST} \s/+public/ [NC]
    RewriteRule ^public/(.*)$ /$1 [R=301,L]

    # Block secrets at the project root.
    RewriteRule ^(\.env|composer\.(json|lock)|artisan) - [F,L]

    # Front the Laravel public directory.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "(^\.env|composer\.(json|lock)|^artisan$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
